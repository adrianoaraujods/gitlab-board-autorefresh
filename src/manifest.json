{
  "manifest_version": 3,
  "name": "Board Auto-Refresh for GitLab",
  "short_name": "Board Auto-Refresh",
  "version": "0.1.0",
  "description": "Auto-refreshes GitLab issue boards while their window is unfocused. Not an official GitLab product.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Board Auto-Refresh for GitLab"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
